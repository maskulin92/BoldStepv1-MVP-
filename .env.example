# ============================================================================
# BOLDSTEP — Environment Variables
# ----------------------------------------------------------------------------
# Copy this file to `.env.local` and fill in real values.
#   cp .env.example .env.local        (macOS/Linux)
#   copy .env.example .env.local      (Windows CMD)
#   Copy-Item .env.example .env.local (PowerShell)
#
# `.env.local` is git-ignored. NEVER commit real credentials.
#
# Every block below is OPTIONAL for local development. Anything left blank
# falls back to mock mode automatically (see MOCK MODE at the bottom), so the
# app boots and every screen works before any credential exists.
# ============================================================================


# ---------------------------------------------------------------------------
# 1. APP CONFIG  (required)
# ---------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development

# Secret used to sign session JWTs. Minimum 32 characters.
# Generate one:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# In development a temporary key is generated at boot if this is blank.
# In production the app REFUSES TO START without it.
JWT_SECRET=

# Secret used to encrypt Meta access tokens at rest (AES-256-GCM). Min 32 chars.
# Generate one:  node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
ENCRYPTION_KEY=


# ---------------------------------------------------------------------------
# 2. FIREBASE — CLIENT SDK (public, safe to expose to the browser)
# ---------------------------------------------------------------------------
NEXT_PUBLIC_FIREBASE_API_KEY=YOUR_KEY_HERE
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=YOUR_DOMAIN.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=YOUR_PROJECT_ID
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=YOUR_BUCKET.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=YOUR_SENDER_ID
NEXT_PUBLIC_FIREBASE_APP_ID=YOUR_APP_ID


# ---------------------------------------------------------------------------
# 3. FIREBASE — ADMIN SDK (server only, NEVER prefix these with NEXT_PUBLIC_)
# ---------------------------------------------------------------------------
# From: Firebase Console -> Project Settings -> Service accounts -> Generate key
FIREBASE_PROJECT_ID=YOUR_PROJECT_ID
FIREBASE_CLIENT_EMAIL=YOUR_EMAIL@project.iam.gserviceaccount.com
# Paste the whole private key on ONE line, wrapped in double quotes, keeping
# the literal \n escapes exactly as they appear in the downloaded JSON:
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEv...\n-----END PRIVATE KEY-----\n"
# Storage bucket the Admin SDK writes creatives + reports to:
FIREBASE_STORAGE_BUCKET=YOUR_BUCKET.appspot.com


# ---------------------------------------------------------------------------
# 4. META ADS
# ---------------------------------------------------------------------------
META_ACCESS_TOKEN=YOUR_ACCESS_TOKEN
META_AD_ACCOUNT_ID=act_XXXXXXXXX
META_API_VERSION=v21.0


# ---------------------------------------------------------------------------
# 5. GLM 5.3  (called by Hermes in Phase 2 — kept here for the fallback path)
# ---------------------------------------------------------------------------
GLM_API_KEY=YOUR_GLM_KEY
GLM_API_BASE=https://api.z.ai/v1
GLM_MODEL=glm-5.3


# ---------------------------------------------------------------------------
# 6. CLAUDE (AI fallback)
# ---------------------------------------------------------------------------
CLAUDE_API_KEY=sk-ant-YOUR_KEY
CLAUDE_MODEL=claude-haiku-4-5-20251001


# ---------------------------------------------------------------------------
# 7. TELEGRAM NOTIFICATIONS (free)
# ---------------------------------------------------------------------------
TELEGRAM_BOT_TOKEN=YOUR_BOT_TOKEN
TELEGRAM_CHAT_ID=YOUR_CHAT_ID


# ---------------------------------------------------------------------------
# 8. OWNER ACCOUNT (bootstrap login before `auth_users` exists in Firestore)
# ---------------------------------------------------------------------------
# Generate the hash:  npm run hash -- "your-password"
# Never put the plaintext password in this file.
OWNER_EMAIL=fadhil@boldstep.my
OWNER_PASSWORD_HASH=


# ---------------------------------------------------------------------------
# 9. HERMES AGENT (Phase 2 — the agent authenticates to this app with this key)
# ---------------------------------------------------------------------------
# Generate:  node -e "console.log('boldstep_sk_' + require('crypto').randomBytes(24).toString('hex'))"
HERMES_API_KEY=


# ---------------------------------------------------------------------------
# 10. MOCK MODE
# ---------------------------------------------------------------------------
# Mock mode is ON automatically whenever Firebase Admin credentials are absent,
# and is HARD-DISABLED in production unless you opt in explicitly below.
# Set to `true` only if you knowingly want a deployed demo with fake data.
BOLDSTEP_ALLOW_MOCK=false
