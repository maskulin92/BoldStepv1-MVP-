# ============================================================================
# BOLDSTEP — Environment Variables
# ----------------------------------------------------------------------------
# Copy this file to `.env.local` and fill in real values.
#   cp .env.example .env.local        (macOS/Linux)
#   copy .env.example .env.local      (Windows CMD)
#   Copy-Item .env.example .env.local (PowerShell)
#
# `.env.local` is git-ignored. NEVER commit real credentials.
#
# Every block below is OPTIONAL for local development. Anything left blank
# falls back to mock mode automatically (see MOCK MODE at the bottom), so the
# app boots and every screen works before any credential exists.
# ============================================================================


# ---------------------------------------------------------------------------
# 1. APP CONFIG  (required)
# ---------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development

# Secret used to sign session JWTs. Minimum 32 characters.
# Generate one:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# In development a temporary key is generated at boot if this is blank.
# In production the app REFUSES TO START without it.
JWT_SECRET=oLXdMByCtbzqgyC_TcmmtnwL0R6-89xdLxD40NSz1g4

# Secret used to encrypt Meta access tokens at rest (AES-256-GCM). Min 32 bytes.
# REQUIRED IN PRODUCTION, and MUST be a separate independent value from
# JWT_SECRET — never reuse the session-signing key here. The app refuses to
# start in production without it.
# Generate one:  node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
ENCRYPTION_KEY=n_DuzqCkmL08k6p3oTbRGO649VPF3DoCVZDpsoO5LK8


# ---------------------------------------------------------------------------
# 2. FIREBASE — CLIENT SDK (public, safe to expose to the browser)
# ---------------------------------------------------------------------------
NEXT_PUBLIC_FIREBASE_API_KEY="boldstep-v1"
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=YOUR_DOMAIN.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=YOUR_PROJECT_ID
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=YOUR_BUCKET.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=YOUR_SENDER_ID
NEXT_PUBLIC_FIREBASE_APP_ID=YOUR_APP_ID


# ---------------------------------------------------------------------------
# 3. FIREBASE — ADMIN SDK (server only, NEVER prefix these with NEXT_PUBLIC_)
# ---------------------------------------------------------------------------
# From: Firebase Console -> Project Settings -> Service accounts -> Generate key
FIREBASE_PROJECT_ID=YOUR_PROJECT_ID
FIREBASE_CLIENT_EMAIL="firebase-adminsdk-fbsvc@boldstep-v1.iam.gserviceaccount.com"
# Paste the whole private key on ONE line, wrapped in double quotes, keeping
# the literal \n escapes exactly as they appear in the downloaded JSON:
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvwIBADANBgkqhkiG9w0BAQEFAASCBKkwggSlAgEAAoIBAQDEw2H0FIhzwBA1\nq7IB3kSVN7PZwRv9xo9Rb6KrVHyx47qQgTnstKl60URDngMs1RhqHmiKYOxk151Y\npup8oJofWSoH/sK5m8e9FT43vbnBf/KIBXrWFydb8EclHrTTAXbNIcXDuBNZ43D1\nPVXKwCDxSaqc8MnVlfaEtWb1yLdEY3kcxqiviNjA5Q0bSCNt2rS++KKqhk3xgHbb\ntz05DWUOPzJsjZ9WpuZViYFQnD94faGH58w+5iSpHBrQUmo87dy4RlD30TGjGgdG\nvBePm4iRsEaFKA7GoZurH3bJXrntb9QqTExSHvk/VBnyM7XZgJKte7D32nFLdXWs\nM+WzAW2HAgMBAAECggEAE3eRNWjipzEVaXn3PqATAQBl1uF4N39xpoj4+yJ8w8zY\nJHvkkzq8md4idt4nSkQ7CiTACxDT0pZShvbctD/ff8J+mhPmiB6VgGudoD4xJqfW\nAwcnxA6+YiY/o7iKA2ZdrqXsvxRzNa1++4R5/HlNyRGUw7o+/da8cRzRdvfIygcw\n+C+5A9EXRHqtKgm8ydyOix0G9/Rux373jtw1MVmEYxWpB6z8rZ0GP22OwD+BLhcx\nCpXPRZcCvQ0aUoEAg13st74wf3Fz5YERxSSiUl79gGv5lY0BLEebHe6KotGrnKuE\nRpCP6uHled30BBBTSunpPt4c6QBEEX8p0EErBdUzwQKBgQDsTjwn+Gn/8dbBzIHL\nuEeeQmCsoYC7mwT7dByYXFbqKZq3Hk3tvJTQdumNIny+50ulbo23aBeCsOAgzzgu\na09ZPkiTQvVIm78ehcWWeNuOsj1sTk0MClN3+mDUCmfcXEOXzNKcICJAtYtXxH5y\npZvivbphFezeZmBaU24I/P55LwKBgQDVKXrSEOXfEFxnO40PtdZZTYxZpgZpR5F4\npdYuMoSqFvDBh9AGdskg6Buux2GeCVz5qPP8sy70kCqhG1hWfnQHHznm3Gv3SIp5\nU+XxahVrchrOyIUmD4CKwZPQpihb0QKBdH/oSAZ/iSzPXWN7TAI2niHQeGLfGqZt\nVX8jqOULKQKBgQCwOV/vRvh14PqRKFwbeuAeC85gr0h7oA3FIEA695HxqvkwWq8u\n/hXUqPlfQTrae08Uni+deUkfM5zRmveA1pIkMaiZ+bNGZK/QqV5C6vqBnjbkUDhx\nJDo/HT+coe32je/ygtMFj4k7zKeP2n+aLBrmqysVP+6XpK1ybwl+Nn3oDQKBgQCP\n1y3KEx0LKT8xaj4GG+5I1MugsyggYusHPuEIy446OMC916fItN+EFRyZFHIK8saK\nsjfyjfdhkOczUACMXUhuhePMpXE1rP3EYZkJD0zk9Fqiry0qQcu71mSop3cUfjXy\npWqqk+/OoAJc6+f1i5TyxkKLKrGNW65ymP7yUUY+AQKBgQCtv7AAs+BjEsCddRgd\nBoOJuKuJqH48St428iFdhFnVzHHq5sGafSr3qzbKKhixweNdFVxuwh00WLCVzzpf\nlsXXUIFVYMjpC1wHa3EplyEbKSqG7UlODb05eKlQVQ5yjZJtzyB4yZVw5eosN4yb\nq+9JbDuIsQZ5eqJcmwYw/Kl6eQ==\n-----END PRIVATE KEY-----\n"
# Storage bucket the Admin SDK writes creatives + reports to:
FIREBASE_STORAGE_BUCKET=YOUR_BUCKET.appspot.com


# ---------------------------------------------------------------------------
# 4. META ADS
# ---------------------------------------------------------------------------
# Tokens are NOT set here anymore — paste each account's system-user token in
# the dashboard (Section A -> account -> Edit -> Meta access token), where it
# is encrypted into Firestore. Leave this section blank.
#
# Only a shared ad account id (not a secret) may be set as a default fallback.
# META_ACCESS_TOKEN / META_SYSTEM_USER_TOKEN are ignored.
META_ACCESS_TOKEN=
META_AD_ACCOUNT_ID=
META_API_VERSION=v21.0


# ---------------------------------------------------------------------------
# 5. GLM  (called by Hermes in Phase 2 — kept here for the fallback path)
# ---------------------------------------------------------------------------
# Endpoint: https://api.z.ai/api/paas/v4  (NOT OpenAI-style /v1)
# glm-5.2 is the flagship on the public API. glm-5.3 exists but is currently
# Coding-Plan-only — set GLM_MODEL=glm-5.3 once its public API ships.
GLM_API_KEY=YOUR_GLM_KEY
GLM_API_BASE=https://api.z.ai/api/paas/v4
GLM_MODEL=glm-5.2


# ---------------------------------------------------------------------------
# 6. CLAUDE (AI fallback)
# ---------------------------------------------------------------------------
CLAUDE_API_KEY=sk-ant-YOUR_KEY
CLAUDE_MODEL=claude-haiku-4-5-20251001


# ---------------------------------------------------------------------------
# 7. TELEGRAM NOTIFICATIONS (free)
# ---------------------------------------------------------------------------
TELEGRAM_BOT_TOKEN=YOUR_BOT_TOKEN
TELEGRAM_CHAT_ID=YOUR_CHAT_ID


# ---------------------------------------------------------------------------
# 8. OWNER ACCOUNT (bootstrap login before `auth_users` exists in Firestore)
# ---------------------------------------------------------------------------
# Generate the hash:  npm run hash -- "your-password"
# Never put the plaintext password in this file.
OWNER_EMAIL=fadhil@boldstep.my
OWNER_PASSWORD_HASH=


# ---------------------------------------------------------------------------
# 9. HERMES AGENT (Phase 2 — the agent authenticates to this app with this key)
# ---------------------------------------------------------------------------
# Generate:  node -e "console.log('boldstep_sk_' + require('crypto').randomBytes(24).toString('hex'))"
# Set the SAME value here (for the app) and in the agent's environment.
HERMES_API_KEY=

# Where the agent finds the app. Usually left at the default.
BOLDSTEP_API_URL=http://localhost:3000
# Overrides the dashboard's Hermes frequency when set (hours). 0 = use dashboard.
HERMES_INTERVAL_HOURS=0


# ---------------------------------------------------------------------------
# 10. WEBHOOK DELIVERY (Phase 2)
# ---------------------------------------------------------------------------
# true -> registered webhooks are delivered (HMAC-signed POSTs with retries).
# unset/false -> events are recorded but not sent.
WEBHOOK_DISPATCH_ENABLED=false


# ---------------------------------------------------------------------------
# 11. MOCK MODE
# ---------------------------------------------------------------------------
# Mock mode is ON automatically whenever Firebase Admin credentials are absent,
# and is HARD-DISABLED in production unless you opt in explicitly below.
# Set to `true` only if you knowingly want a deployed demo with fake data.
BOLDSTEP_ALLOW_MOCK=false
